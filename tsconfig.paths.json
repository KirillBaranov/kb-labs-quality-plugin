{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@kb-labs/plugin-contracts": [
        "../../infra/kb-labs-plugin/packages/plugin-contracts/src/index.ts"
      ],
      "@kb-labs/plugin-contracts/*": [
        "../../infra/kb-labs-plugin/packages/plugin-contracts/src/*"
      ],
      "@kb-labs/plugin-runtime": [
        "../../infra/kb-labs-plugin/packages/plugin-runtime/src/index.ts"
      ],
      "@kb-labs/plugin-runtime/*": [
        "../../infra/kb-labs-plugin/packages/plugin-runtime/src/*"
      ],
      "@kb-labs/quality-contracts": [
        "packages/quality-contracts/src/index.ts"
      ],
      "@kb-labs/quality-contracts/*": [
        "packages/quality-contracts/src/*"
      ],
      "@kb-labs/quality-core": [
        "packages/quality-core/src/index.ts"
      ],
      "@kb-labs/quality-core/*": [
        "packages/quality-core/src/*"
      ],
      "@kb-labs/sdk": [
        "../../platform/kb-labs-sdk/packages/sdk/src/index.ts"
      ],
      "@kb-labs/sdk/*": [
        "../../platform/kb-labs-sdk/packages/sdk/src/*"
      ],
      "@kb-labs/studio-plugin-tools": [
        "../../platform/kb-labs-studio/packages/studio-plugin-tools/src/index.ts"
      ],
      "@kb-labs/studio-plugin-tools/*": [
        "../../platform/kb-labs-studio/packages/studio-plugin-tools/src/*"
      ]
    }
  }
}
